# ── build mapping ────────────────────────────────────────────────────────

build_family() {
    case "${1%%.*}" in
        26100) echo ws2025;; 25398) echo ws2025-23h2;; 20348) echo ws2022;;
        17763) echo ws2019;; 14393) echo ws2016;; 22631) echo win11-23h2;;
        22621) echo win11-22h2;; 22000) echo win11-21h2;; 1904[1-5]) echo win10-2004;;
        19041) echo win10-2004;; 18363) echo win10-1909;; 18362) echo win10-1903;;
        *) echo "win-${1%%.*}";;
    esac
}

build_edition() {
    case "$(build_family "$1")" in ws*) echo ServerStandard;; *) echo Professional;; esac
}

# KMS generic client keys (for non-eval ISOs)
build_kms_key() {
    case "${1%%.*}" in
        26100) echo "TVRH6-WHNXV-R9WG3-9XRFY-MY832";;  # WS2025 Std
        20348) echo "VDYBN-27WPP-V4HQT-9VMD4-VMK7H";;  # WS2022 Std
        17763) echo "N69G4-B89J2-4G8F4-WWYCC-J464C";;  # WS2019 Std
        14393) echo "WC2BQ-8NRM3-FDDYY-2BFGV-KHKQY";;  # WS2016 Std
        22631|22621|22000) echo "W269N-WFGWX-YVC9B-4J6C9-T83GX";; # W11 Pro
        1904[1-5]|19041) echo "W269N-WFGWX-YVC9B-4J6C9-T83GX";;   # W10 2004 Pro
        18363|18362) echo "W269N-WFGWX-YVC9B-4J6C9-T83GX";;        # W10 1903/1909 Pro
        *) echo "";;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: iso
# ═══════════════════════════════════════════════════════════════════════════

cmd_iso() {
    local build="" edition=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --build|-b) build="$2"; shift 2;;
            --edition|-e) edition="$2"; shift 2;;
            *) build="${build:-$1}"; shift;;
        esac
    done
    [[ -z "$build" ]] && die "Usage: xdev-lab iso --build <number>"
    local fam=$(build_family "$build")
    [[ -z "$edition" ]] && edition=$(build_edition "$build")
    local out="$LAB/iso/${fam}_${build}_${edition}.iso"

    [[ -f "$out" ]] && { ok "ISO exists: $out"; return 0; }

    local w="$LAB/work/uup_${build}"
    mkdir -p "$w" "$LAB/iso"

    log "Building ISO for $build ($fam $edition)"

    # ── 1. find UUID on UUP dump ──
    log "Querying UUP dump API..."
    local uuid
    uuid=$(UUP_BUILD="$build" UUP_FAM="$fam" python3 << 'PYEOF'
import urllib.request, json, os
build = os.environ.get("UUP_BUILD","")
major = build.split(".")[0]
fam = os.environ.get("UUP_FAM","")
req = urllib.request.Request(
    f"https://api.uupdump.net/listid.php?search={major}",
    headers={"User-Agent":"Mozilla/5.0 (X11; Linux x86_64)"})
try:
    data = json.loads(urllib.request.urlopen(req,timeout=20).read())
except Exception as e:
    print("API_ERROR"); exit(1)
builds = data.get("response",{}).get("builds",{})
cands = []
for k,info in builds.items():
    b,t = info.get("build",""), info.get("title","").lower()
    if b != build: continue
    if any(w in t for w in ["insider","preview","canary","beta"]): continue
    sc = 0
    if "server" in fam and any(w in t for w in ["server","microsoft server"]): sc += 10
    if "win10" in fam and "windows 10" in t: sc += 10
    if "win11" in fam and "windows 11" in t: sc += 10
    if "feature update" not in t: sc += 5  # prefer CU over feature update
    cands.append((sc, info["uuid"], t))
cands.sort(key=lambda x:-x[0])
print(cands[0][1] if cands else "NOT_FOUND")
PYEOF
    ) || uuid="NOT_FOUND"

    if [[ "$uuid" == "NOT_FOUND" || -z "$uuid" ]]; then
        warn "Build $build not on UUP dump. Nearby builds:"
        python3 -c "
import urllib.request,json,sys
req=urllib.request.Request('https://api.uupdump.net/listid.php?search=${build%%.*}',headers={'User-Agent':'Mozilla/5.0'})
d=json.loads(urllib.request.urlopen(req,timeout=15).read())
bs=d.get('response',{}).get('builds',{})
t=int('$build'.split('.')[1]) if '.' in '$build' else 0
near={}
for k,i in bs.items():
    b=i.get('build','')
    if not b.startswith('${build%%.*}.'): continue
    try:
        m=int(b.split('.')[1]); d2=abs(m-t)
        if d2<=500 and b not in near: near[b]=(d2,i['title'])
    except: pass
for b,(d2,tt) in sorted(near.items(),key=lambda x:x[1][0])[:8]:
    print(f'  {b:20s} (+{d2:3d}) {tt}')
" 2>&1
        die "Use a nearby build or provide --iso manually"
    fi
    ok "UUID: $uuid"

    # ── 2. download UUP package ──
    if [[ ! -f "$w/uup_download_linux.sh" ]]; then
        log "Fetching UUP download package..."
        curl -sfL "https://uupdump.net/get.php?id=${uuid}&pack=en-us&edition=${edition}&autodl=2" \
            -H "User-Agent: Mozilla/5.0" -o "$w/uup_download.zip" || die "Failed to fetch UUP package"
        unzip -qo "$w/uup_download.zip" -d "$w/"
    fi

    # ── 3. get converter if missing ──
    if [[ ! -s "$w/files/convert.sh" ]]; then
        log "Fetching converter..."
        mkdir -p "$w/files"
        curl -sfL "https://git.uupdump.net/uup-dump/converter/raw/branch/main/convert.sh" \
            -o "$w/files/convert.sh" 2>/dev/null || true
        if [[ ! -s "$w/files/convert.sh" ]]; then
            # fallback: copy from any existing build's converter
            local cached=$(find "$LAB/work" -path "*/files/convert.sh" -size +1k 2>/dev/null | head -1)
            if [[ -n "$cached" ]]; then
                cp "$cached" "$w/files/convert.sh"
                cp "$(dirname "$cached")/convert_ve_plugin" "$w/files/" 2>/dev/null || true
                log "Using cached converter from $cached"
            else
                die "Cannot fetch converter and no cached copy found"
            fi
        fi
        chmod +x "$w/files/convert.sh"
    fi

    # ── 4. download packages ──
    if [[ ! -d "$w/UUPs" ]] || [[ $(ls "$w/UUPs/" 2>/dev/null | wc -l) -lt 10 ]]; then
        log "Downloading package list..."
        aria2c --no-conf --console-log-level=warn \
            -o aria2_script.txt --dir="$w" \
            --allow-overwrite=true --auto-file-renaming=false \
            "https://uupdump.net/get.php?id=${uuid}&pack=en-us&edition=${edition}&aria2=2" 2>&1 | tail -2
        mkdir -p "$w/UUPs"
        log "Downloading Windows packages from Microsoft (this takes a while)..."
        aria2c --no-conf --console-log-level=warn \
            -x16 -s16 -j5 -c -R -d"$w/UUPs" -i"$w/aria2_script.txt" 2>&1 | tail -5
    fi
    ok "Packages: $(ls "$w/UUPs/" | wc -l) files, $(du -sh "$w/UUPs/" | cut -f1)"

    # ── 5. convert to ISO ──
    log "Converting to ISO (this takes 10-20 minutes)..."
    # Clean any leftover ISODIR from a previous failed run (prevents corrupt WIM)
    rm -rf "$w/ISODIR" 2>/dev/null
    # chntpw stub (converter checks for it but we don't need it for server)
    mkdir -p "$HOME/bin"
    [[ -f "$HOME/bin/chntpw" ]] || { printf '#!/bin/bash\nexit 0\n' > "$HOME/bin/chntpw"; chmod +x "$HOME/bin/chntpw"; }
    export PATH="$HOME/bin:$PATH"
    ( cd "$w" && bash files/convert.sh wim UUPs 0 ) 2>&1 | tail -5

    local produced
    produced=$(find "$w" -maxdepth 1 \( -name "*.ISO" -o -name "*.iso" \) 2>/dev/null | head -1)
    [[ -n "$produced" ]] || die "ISO conversion failed. Check $w/ for errors."
    mv "$produced" "$out"
    ok "ISO: $out ($(du -h "$out" | cut -f1))"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: vm
# ═══════════════════════════════════════════════════════════════════════════

cmd_vm() {
    local name="" iso="" build="" ram=4096 cpus=2 disk=60 ip=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name|-n) name="$2"; shift 2;;
            --iso|-i)  iso="$2"; shift 2;;
            --build|-b) build="$2"; shift 2;;
            --ram)  ram="$2"; shift 2;;
            --cpus) cpus="$2"; shift 2;;
            --disk) disk="$2"; shift 2;;
            --ip)   ip="$2"; shift 2;;
            *) die "vm: unknown flag $1";;
        esac
    done

    # resolve ISO from build if needed
    if [[ -n "$build" && -z "$iso" ]]; then
        local fam=$(build_family "$build")
        iso=$(find "$LAB/iso" -name "${fam}_${build}_*.iso" 2>/dev/null | head -1)
        if [[ -z "$iso" ]]; then
            log "No ISO for $build — building..."
            cmd_iso --build "$build"
            iso=$(find "$LAB/iso" -name "${fam}_${build}_*.iso" 2>/dev/null | head -1)
        fi
    fi
    [[ -z "$name" ]] && die "vm: --name required"
    [[ -z "$iso" ]]  && die "vm: --iso or --build required"
    [[ -f "$iso" ]]  || die "ISO not found: $iso"

    net_ensure
    [[ -z "$ip" ]] && ip=$(next_ip)
    local last_octet="${ip##*.}"
    local tap="tap-${name}"
    local mac="52:54:00:dc:00:$(printf '%02x' "$last_octet")"
    local vnc_num=$((last_octet - 8)); (( vnc_num < 1 )) && vnc_num=2
    local qmp_sock="$(vm_qmp "$name")"
    local dimg="$(vm_disk "$name")"

    # Kill any existing VM with this name
    if vm_running "$name"; then
        warn "VM '$name' already running — stopping it first"
        kill "$(vm_pid "$name")" 2>/dev/null
        sleep 2
    fi
    # Clean stale TAP
    sudo ip link del "$tap" 2>/dev/null || true

    log "Creating VM '$name' from $iso"
    log "  IP=$ip  VNC=127.0.0.1:$((5900+vnc_num))  MAC=$mac"
    mkdir -p "$LAB/images"

    # ── disk ──
    [[ -f "$dimg" ]] && { warn "Disk exists — removing for fresh install"; rm -f "$dimg"; }
    qemu-img create -f qcow2 "$dimg" "${disk}G" >/dev/null

    # ── detect ISO config (image index + product key) ──
    detect_iso_config "$iso" "${build:-0}"
    local img_index="$_IMG_INDEX"
    local key_xml="$_PRODUCT_KEY_XML"

    local au_xml="$LAB/images/${name}_autounattend.xml"
    cat > "$au_xml" << AUEOF
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <SetupUILanguage><UILanguage>en-US</UILanguage></SetupUILanguage>
      <InputLocale>en-US</InputLocale><SystemLocale>en-US</SystemLocale><UILanguage>en-US</UILanguage><UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <DiskConfiguration><Disk wcm:action="add"><DiskID>0</DiskID><WillWipeDisk>true</WillWipeDisk>
        <CreatePartitions><CreatePartition wcm:action="add"><Order>1</Order><Extend>true</Extend><Type>Primary</Type></CreatePartition></CreatePartitions>
        <ModifyPartitions><ModifyPartition wcm:action="add"><Order>1</Order><PartitionID>1</PartitionID><Format>NTFS</Format><Label>Windows</Label><Letter>C</Letter><Active>true</Active></ModifyPartition></ModifyPartitions>
      </Disk></DiskConfiguration>
      <ImageInstall><OSImage><InstallTo><DiskID>0</DiskID><PartitionID>1</PartitionID></InstallTo>
        <InstallFrom><MetaData wcm:action="add"><Key>/IMAGE/INDEX</Key><Value>${img_index}</Value></MetaData></InstallFrom>
      </OSImage></ImageInstall>
      <UserData><AcceptEula>true</AcceptEula><ProductKey><WillShowUI>Never</WillShowUI>${key_xml}</ProductKey></UserData>
    </component>
  </settings>
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>${name^^}</ComputerName><TimeZone>UTC</TimeZone>
    </component>
    <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <fDenyTSConnections>false</fDenyTSConnections>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale><SystemLocale>en-US</SystemLocale><UILanguage>en-US</UILanguage><UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <OOBE><HideEULAPage>true</HideEULAPage><HideLocalAccountScreen>true</HideLocalAccountScreen><HideOEMRegistrationScreen>true</HideOEMRegistrationScreen><HideOnlineAccountScreens>true</HideOnlineAccountScreens><HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE><ProtectYourPC>3</ProtectYourPC></OOBE>
      <UserAccounts><AdministratorPassword><Value>${PASSWORD}</Value><PlainText>true</PlainText></AdministratorPassword></UserAccounts>
      <AutoLogon><Enabled>true</Enabled><Username>Administrator</Username><Password><Value>${PASSWORD}</Value><PlainText>true</PlainText></Password><LogonCount>3</LogonCount></AutoLogon>
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add"><Order>1</Order><CommandLine>cmd /c powershell -NoProfile -Command "Set-NetFirewallProfile -All -Enabled False"</CommandLine><Description>Disable firewall</Description></SynchronousCommand>
        <SynchronousCommand wcm:action="add"><Order>2</Order><CommandLine>cmd /c powershell -NoProfile -Command "\$a=(Get-NetAdapter|Select -First 1).Name; New-NetIPAddress -InterfaceAlias \$a -IPAddress ${ip} -PrefixLength 24 -DefaultGateway ${HOST_IP} -EA SilentlyContinue; Set-DnsClientServerAddress -InterfaceAlias \$a -ServerAddresses ${HOST_IP},8.8.8.8"</CommandLine><Description>Static IP</Description></SynchronousCommand>
        <SynchronousCommand wcm:action="add"><Order>3</Order><CommandLine>cmd /c powershell -NoProfile -Command "Enable-PSRemoting -Force -SkipNetworkProfileCheck; Set-Item WSMan:\localhost\Client\TrustedHosts -Value '*' -Force"</CommandLine><Description>WinRM</Description></SynchronousCommand>
        <SynchronousCommand wcm:action="add"><Order>4</Order><CommandLine>cmd /c powershell -NoProfile -Command "Set-ExecutionPolicy RemoteSigned -Force"</CommandLine><Description>ExecPolicy</Description></SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
AUEOF

    # ── floppy image ──
    local floppy="$LAB/images/${name}_floppy.img"
    dd if=/dev/zero of="$floppy" bs=1024 count=1440 2>/dev/null
    mkfs.fat "$floppy" >/dev/null 2>&1
    local mnt=$(mktemp -d)
    sudo mount -o loop "$floppy" "$mnt"
    sudo cp "$au_xml" "$mnt/autounattend.xml"
    sudo umount "$mnt"; rmdir "$mnt"

    # ── launch QEMU ──
    tap_ensure "$tap"
    rm -f "$qmp_sock"
    local qemu_out
    qemu_out=$(qemu-system-x86_64 \
        -name "$name" -machine pc,accel=kvm -cpu host -smp "$cpus" -m "$ram" \
        -hda "$dimg" -cdrom "$iso" -drive file="$floppy",format=raw,if=floppy -boot d \
        -device e1000e,netdev=n0,mac="$mac" \
        -netdev tap,id=n0,ifname="$tap",script=no,downscript=no \
        -vga std -display none -vnc "127.0.0.1:${vnc_num}" \
        -usb -device usb-tablet \
        -qmp "unix:${qmp_sock},server,nowait" \
        -daemonize 2>&1) || true

    # Verify QEMU actually started
    sleep 1
    if ! vm_running "$name"; then
        err "QEMU failed to start:"
        echo "$qemu_out" >&2
        die "Check: is the ISO path correct? Is KVM available? Is the TAP free?"
    fi

    _db_set "$name" ip "$ip"
    _db_set "$name" build "${build:-unknown}"
    _db_set "$name" tap "$tap"
    _db_set "$name" vnc "$((5900+vnc_num))"
    _db_set "$name" status installing

    ok "VM '$name' launched (PID $(vm_pid "$name"))"
    log "VNC: 127.0.0.1:$((5900+vnc_num))"
    log "Waiting for OS install + first boot..."

    # ── wait for network ──
    local t=0 dhcp_tried=false
    while (( t < 2400 )); do
        if ping -c1 -W2 "$ip" &>/dev/null; then
            break
        fi
        # DHCP fallback: detect VM on a different IP via MAC, try to set static IP ONCE
        if ! $dhcp_tried; then
            local dhcp_ip=$(ip neigh show dev "$BRIDGE" 2>/dev/null \
                | grep "$mac" | grep -v FAILED | grep -v INCOMPLETE | awk '{print $1}' | head -1)
            if [[ -n "$dhcp_ip" && "$dhcp_ip" != "$ip" ]]; then
                log "Detected at DHCP $dhcp_ip — attempting to set static IP $ip..."
                if vm_exec "$dhcp_ip" "powershell -Command \"Set-NetFirewallProfile -All -Enabled False; \$a=(Get-NetAdapter|Select -First 1).Name; New-NetIPAddress -InterfaceAlias \$a -IPAddress $ip -PrefixLength 24 -DefaultGateway $HOST_IP -EA SilentlyContinue\"" &>/dev/null; then
                    ok "Static IP set via DHCP fallback"
                    sleep 10
                else
                    log "Could not reach VM at $dhcp_ip yet (firewall?) — waiting for FirstLogonCommands to set IP..."
                fi
                dhcp_tried=true
            fi
        fi
        sleep 15; t=$((t+15))
        (( t % 120 == 0 )) && log "Still installing... (${t}s)"
    done

    if ! ping -c1 -W2 "$ip" &>/dev/null; then
        warn "VM not reachable at $ip after ${t}s. Check VNC."
        return 1
    fi

    # wait for SMB
    local st=0
    while ! nmap -sT -Pn -p445 "$ip" 2>/dev/null | grep -q "open"; do
        sleep 5; st=$((st+5)); (( st >= 180 )) && break
    done

    _db_set "$name" status running
    local ver=$(vm_exec "$ip" 'powershell -Command "(Get-Item C:\Windows\System32\ntoskrnl.exe).VersionInfo.FileVersion"' 2>/dev/null | tail -1)
    [[ -n "$ver" ]] && _db_set "$name" version "$ver"
    ok "VM '$name' ready at $ip (version: ${ver:-?})"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: tools
# ═══════════════════════════════════════════════════════════════════════════

cmd_tools() {
    local name="" profile="exploit-dev"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --profile|-p) profile="$2"; shift 2;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "tools: --vm <name> required"
    local ip; ip=$(require_vm "$name")

    log "Installing tools ($profile) on $name ($ip)..."

    # ── core: crash dumps, symbols, netlogon debug ──
    log "Configuring crash dumps and symbols..."
    vm_exec "$ip" 'powershell -Command "
mkdir C:\Tools,C:\Symbols,C:\CrashDumps -Force >$null
[Environment]::SetEnvironmentVariable(\"_NT_SYMBOL_PATH\",\"srv*C:\Symbols*https://msdl.microsoft.com/download/symbols\",\"Machine\")
Set-ItemProperty HKLM:\SYSTEM\CurrentControlSet\Control\CrashControl -Name CrashDumpEnabled -Value 1
Set-ItemProperty HKLM:\SYSTEM\CurrentControlSet\Control\CrashControl -Name AutoReboot -Value 0
$p=\"HKLM:\SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\lsass.exe\"
New-Item -Path $p -Force >$null
Set-ItemProperty $p -Name DumpFolder -Value C:\CrashDumps -Type ExpandString
Set-ItemProperty $p -Name DumpType -Value 2 -Type DWord
Set-ItemProperty $p -Name DumpCount -Value 10 -Type DWord
nltest /dbflag:0x2080ffff 2>$null
Write-Host OK
"' 2>/dev/null
    ok "Crash dumps + symbol path + netlogon debug configured"

    if [[ "$profile" == "minimal" ]]; then
        ok "Minimal profile done"; return 0
    fi

    # ── sysinternals ──
    log "Installing Sysinternals..."
    vm_exec "$ip" 'powershell -Command "
Invoke-WebRequest https://download.sysinternals.com/files/SysinternalsSuite.zip -OutFile C:\Tools\ss.zip -UseBasicParsing
Expand-Archive C:\Tools\ss.zip C:\Tools\Sysinternals -Force; Remove-Item C:\Tools\ss.zip
Write-Host OK
"' 2>/dev/null
    ok "Sysinternals installed"

    # ── x64dbg ──
    log "Installing x64dbg..."
    vm_exec "$ip" 'powershell -Command "
try {
    $r=Invoke-RestMethod https://api.github.com/repos/x64dbg/x64dbg/releases/latest -UseBasicParsing
    $a=$r.assets|?{$_.name -like \"snapshot_*.zip\"}|Select -First 1
    if($a){Invoke-WebRequest $a.browser_download_url -OutFile C:\Tools\x64dbg.zip -UseBasicParsing; Expand-Archive C:\Tools\x64dbg.zip C:\Tools\x64dbg -Force; Remove-Item C:\Tools\x64dbg.zip; Write-Host OK}
} catch { Write-Host SKIP }
"' 2>/dev/null

    # ── python ──
    log "Installing Python..."
    vm_exec "$ip" 'powershell -Command "
$u=\"https://www.python.org/ftp/python/3.12.8/python-3.12.8-amd64.exe\"
Invoke-WebRequest $u -OutFile C:\Tools\pyinst.exe -UseBasicParsing
Start-Process C:\Tools\pyinst.exe -ArgumentList \"/quiet\",\"InstallAllUsers=1\",\"PrependPath=1\" -Wait
Remove-Item C:\Tools\pyinst.exe
Write-Host OK
"' 2>/dev/null
    ok "Python installed"

    if [[ "$profile" == "exploit-dev" || "$profile" == "re-only" ]]; then
        # ── WinDbg ──
        log "Installing WinDbg (attempting winget)..."
        vm_exec "$ip" 'powershell -Command "
try { winget install Microsoft.WinDbg --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null; Write-Host OK }
catch { Write-Host SKIP-winget-unavailable }
"' 2>/dev/null
    fi

    ok "Tools ($profile) installed on $name"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: ad
# ═══════════════════════════════════════════════════════════════════════════

cmd_ad() {
    local name="" domain="corp.local" netbios=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --domain|-d) domain="$2"; shift 2;;
            --netbios) netbios="$2"; shift 2;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "ad: --vm <name> required"
    local ip; ip=$(require_vm "$name")
    [[ -z "$netbios" ]] && netbios=$(echo "$domain" | cut -d. -f1 | tr '[:lower:]' '[:upper:]')

    log "Setting up AD DS on $name ($ip)"
    log "  Domain: $domain  NetBIOS: $netbios"

    # install role
    vm_exec "$ip" 'powershell -Command "Install-WindowsFeature AD-Domain-Services -IncludeManagementTools"' 2>/dev/null | grep -i success
    ok "AD DS role installed"

    # promote
    log "Promoting to DC (this takes several minutes + reboot)..."
    vm_exec "$ip" "powershell -Command \"Import-Module ADDSDeployment; Install-ADDSForest -DomainName '$domain' -DomainNetbiosName '$netbios' -SafeModeAdministratorPassword (ConvertTo-SecureString '$PASSWORD' -AsPlainText -Force) -InstallDNS -Force\"" 2>/dev/null || true

    # wait for reboot
    log "Waiting for DC to reboot..."
    sleep 15
    local t=0
    while ! ping -c1 -W2 "$ip" &>/dev/null; do
        sleep 10; t=$((t+10)); (( t >= 300 )) && { warn "DC not back after 300s"; return 1; }
    done
    # wait for SMB
    sleep 20
    local st=0
    while ! nmap -sT -Pn -p445 "$ip" 2>/dev/null | grep -q "open"; do
        sleep 10; st=$((st+10)); (( st >= 120 )) && break
    done

    # fix DNS to self
    vm_exec "$ip" "powershell -Command \"Set-DnsClientServerAddress -InterfaceAlias (Get-NetAdapter|Select -First 1 -Expand Name) -ServerAddresses 127.0.0.1,$HOST_IP\"" 2>/dev/null || true

    _db_set "$name" domain "$domain"
    _db_set "$name" netbios "$netbios"
    ok "DC promotion complete: $domain"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: update (apply a Windows CU to a running VM)
# ═══════════════════════════════════════════════════════════════════════════

cmd_update() {
    local name="" kb="" msu=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --kb|-k) kb="$2"; shift 2;;
            --msu|-m) msu="$2"; shift 2;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "update: --vm <name> required"
    [[ -z "$kb" && -z "$msu" ]] && die "update: --kb <KB number> or --msu <path> required"
    local ip; ip=$(require_vm "$name")

    if [[ -n "$msu" && -f "$msu" ]]; then
        log "Uploading $msu to VM..."
        vm_upload "$ip" "$msu" "Windows/Temp/$(basename "$msu")"
        kb=$(basename "$msu" .msu)
    fi

    log "Installing $kb on $name..."
    vm_exec "$ip" "powershell -Command \"
        \$msu = Get-ChildItem C:\\Windows\\Temp\\*.msu | Select -First 1
        if (\$msu) {
            Write-Host ('Installing ' + \$msu.Name + '...')
            wusa.exe \$msu.FullName /quiet /norestart
            Write-Host 'Done — reboot required'
        } else {
            Write-Host 'No MSU found in C:\\Windows\\Temp\\'
        }
    \"" 2>/dev/null

    ok "Update applied. Reboot with: xdev-lab stop $name && xdev-lab start $name"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: snapshot
# ═══════════════════════════════════════════════════════════════════════════

cmd_snapshot() {
    local name="" action="" snap=""
    for arg in "$@"; do
        case "$arg" in
            create|restore|list|delete) action="$arg";;
            *) [[ -z "$name" ]] && name="$arg" || snap="$arg";;
        esac
    done
    [[ -z "$name" || -z "$action" ]] && die "Usage: xdev-lab snapshot <name> <create|restore|list|delete> [snap]"
    local d=$(vm_disk "$name")
    [[ -f "$d" ]] || die "Disk not found: $d"

    case "$action" in
        create)
            [[ -z "$snap" ]] && die "Snapshot name required"
            vm_running "$name" && die "Stop VM first"
            qemu-img snapshot -c "$snap" "$d"; ok "Snapshot '$snap' created";;
        restore)
            [[ -z "$snap" ]] && die "Snapshot name required"
            vm_running "$name" && die "Stop VM first"
            qemu-img snapshot -a "$snap" "$d"; ok "Restored '$snap'";;
        list)
            qemu-img snapshot -l "$d" 2>/dev/null || echo "No snapshots";;
        delete)
            [[ -z "$snap" ]] && die "Snapshot name required"
            qemu-img snapshot -d "$snap" "$d"; ok "Deleted '$snap'";;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: start / stop / destroy
# ═══════════════════════════════════════════════════════════════════════════

cmd_start() {
    local name="" debug="" extra="" cpus=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)      debug="${2:-gdb}"; shift 2;;
            --qemu-extra) extra="$2"; shift 2;;
            --cpus)       cpus="$2"; shift 2;;
            --break)      extra="${extra} -S"; shift;;
            -*)           die "start: unknown flag $1";;
            *)            name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "Usage: xdev-lab start <name> [--debug gdb|serial|both] [--cpus N] [--qemu-extra '...']"

    local d=$(vm_disk "$name")
    [[ -f "$d" ]] || die "Disk not found: $d"
    vm_running "$name" && { ok "'$name' already running"; return 0; }

    net_ensure
    local ip=$(vm_ip "$name") tap="tap-${name}"
    local last=${ip##*.}
    local vnc=$((last - 8)); (( vnc < 1 )) && vnc=2
    local qmp_sock=$(vm_qmp "$name")
    local smp="${cpus:-2}"
    tap_ensure "$tap"; rm -f "$qmp_sock"

    local debug_flags=""
    case "$debug" in
        gdb)    debug_flags="-s";;
        serial) debug_flags="-serial tcp::$((4440+last)),server,nowait";;
        both)   debug_flags="-s -serial tcp::$((4440+last)),server,nowait";;
    esac

    qemu-system-x86_64 \
        -name "$name" -machine pc,accel=kvm -cpu host -smp "$smp" -m 4096 \
        -hda "$d" -boot c \
        -device e1000e,netdev=n0,mac="52:54:00:dc:00:$(printf '%02x' "$last")" \
        -netdev tap,id=n0,ifname="$tap",script=no,downscript=no \
        -vga std -display none -vnc "127.0.0.1:${vnc}" \
        -usb -device usb-tablet \
        -qmp "unix:${qmp_sock},server,nowait" \
        $debug_flags $extra \
        -daemonize 2>&1

    _db_set "$name" status running
    ok "'$name' started (VNC: 127.0.0.1:$((5900+vnc)))"
    [[ -n "$debug" ]] && {
        case "$debug" in
            gdb)    ok "GDB stub: localhost:1234 — connect with: gdb -ex 'target remote :1234'";;
            serial) ok "KD serial: localhost:$((4440+last)) — connect WinDbg: -k com:port=//./pipe/com_$((4440+last)),baud=115200";;
            both)   ok "GDB: :1234  KD serial: :$((4440+last))";;
        esac
    }
}

cmd_stop() {
    local name="${1:?Usage: xdev-lab stop <name>}" force="${2:-}"
    local pid=$(vm_pid "$name")
    [[ -z "$pid" ]] && { ok "'$name' not running"; return 0; }

    if [[ "$force" == "--force" ]]; then
        kill -9 "$pid" 2>/dev/null; ok "Force-killed '$name'"; return 0
    fi

    qmp "$name" '{"execute":"system_powerdown"}' &>/dev/null
    local w=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep 2; w=$((w+2)); (( w >= 60 )) && { kill -9 "$pid" 2>/dev/null; break; }
    done
    _db_set "$name" status stopped
    ok "'$name' stopped"
}

cmd_destroy() {
    local name="${1:?Usage: xdev-lab destroy <name>}"
    cmd_stop "$name" --force 2>/dev/null || true
    rm -f "$(vm_disk "$name")" "$LAB/images/${name}_"*
    sudo ip link del "tap-${name}" 2>/dev/null || true
    _db_del "$name"
    ok "'$name' destroyed"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: list / exec / extract / screenshot
# ═══════════════════════════════════════════════════════════════════════════

cmd_list() {
    [[ ! -f "$DB" ]] && { echo "No VMs."; return; }
    python3 -c "
import json,subprocess as sp
db=json.load(open('$DB'))
print(f'{\"NAME\":<18}{\"IP\":<16}{\"BUILD\":<16}{\"STATUS\":<10}{\"VERSION\":<24}{\"DOMAIN\"}')
print('-'*110)
for n,i in sorted(db.items()):
    run='running' if sp.run(['pgrep','-f',f'qemu.*-name {n}'],capture_output=True).returncode==0 else 'stopped'
    ver=i.get('version','?')[:22]
    dom=i.get('domain','-')
    if len(dom)>35: dom=dom[:15]+'...'+dom[-15:]
    print(f'{n:<18}{i.get(\"ip\",\"?\"):<16}{i.get(\"build\",\"?\"):<16}{run:<10}{ver:<24}{dom}')
"
}

cmd_exec() {
    local name="${1:?Usage: xdev-lab exec <name> <cmd>}"; shift
    local ip; ip=$(require_vm "$name")
    vm_exec "$ip" "$*"
}

cmd_extract() {
    local name="${1:?}" remote="${2:?}" dst="${3:?}"
    local ip; ip=$(require_vm "$name")
    vm_download "$ip" "$remote" "$dst"
    ok "$remote -> $dst"
}

cmd_screenshot() {
    local name="${1:?}" out="${2:-/tmp/${1}-screen.png}"
    qmp "$name" '{"execute":"screendump","arguments":{"filename":"/tmp/_qmp_screen.ppm"}}' >/dev/null
    convert /tmp/_qmp_screen.ppm "$out" 2>/dev/null || cp /tmp/_qmp_screen.ppm "$out"
    ok "Screenshot: $out"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: create (all-in-one)
# ═══════════════════════════════════════════════════════════════════════════

cmd_create() {
    local build="" name="" tools="" domain="" edition=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --build|-b) build="$2"; shift 2;;
            --name|-n)  name="$2"; shift 2;;
            --tools|-t) tools="$2"; shift 2;;
            --ad)       domain="$2"; shift 2;;
            --edition)  edition="$2"; shift 2;;
            *) die "create: unknown flag $1";;
        esac
    done
    [[ -z "$build" ]] && die "create: --build required"
    [[ -z "$name" ]] && name="$(build_family "$build")-${build}"

    cmd_iso --build "$build" ${edition:+--edition "$edition"}
    cmd_vm --name "$name" --build "$build"
    [[ -n "$tools" ]] && cmd_tools --vm "$name" --profile "$tools"
    [[ -n "$domain" ]] && cmd_ad --vm "$name" --domain "$domain"

    ok "Lab VM '$name' complete (build $build)"
    cmd_list
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: debug — start VM with kernel debug support
# ═══════════════════════════════════════════════════════════════════════════

cmd_debug() {
    local name="" mode="gdb"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --mode|-m) mode="$2"; shift 2;;
            --enable) # enable kernel debug on a running VM (bcdedit)
                name="$2"; shift 2
                local ip; ip=$(require_vm "$name")
                log "Enabling kernel debug on $name..."
                vm_exec "$ip" 'powershell -Command "bcdedit /debug on; bcdedit /dbgsettings serial debugport:1 baudrate:115200; bcdedit /set numproc 1"' 2>/dev/null
                ok "Kernel debug enabled. Reboot required: xdev-lab stop $name && xdev-lab start $name --debug serial"
                return 0;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "Usage: xdev-lab debug --vm <name> [--mode gdb|serial|both] or debug --enable <name>"

    # Stop if running, then start with debug flags
    vm_running "$name" && { log "Stopping $name..."; cmd_stop "$name"; sleep 2; }
    cmd_start "$name" --debug "$mode"
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: feature — toggle Windows features remotely
# ═══════════════════════════════════════════════════════════════════════════

cmd_feature() {
    local name="" action="" feat="" do_list=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --enable)  action="enable"; feat="$2"; shift 2;;
            --disable) action="disable"; feat="$2"; shift 2;;
            --list) do_list=true; shift;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "Usage: xdev-lab feature --vm <name> --enable|--disable <feature> | --list"
    local ip; ip=$(require_vm "$name")

    if $do_list; then
        log "Querying features on $name ($ip)..."
        # Run simple commands separately to avoid wmiexec timeout on complex PS
        echo "  Firewall:        $(vm_exec "$ip" 'powershell -Command "(Get-NetFirewallProfile|Select -First 1).Enabled"' 2>/dev/null | tail -1)"
        echo "  RDP:             $(vm_exec "$ip" 'reg query "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections 2>nul' 2>/dev/null | grep -oP '0x\d')"
        echo "  KernelDebug:     $(vm_exec "$ip" 'bcdedit /enum {current} 2>nul | findstr debug' 2>/dev/null | tail -1)"
        echo "  NumProc:         $(vm_exec "$ip" 'bcdedit /enum {current} 2>nul | findstr numproc' 2>/dev/null | tail -1)"
        echo "  TestSigning:     $(vm_exec "$ip" 'bcdedit /enum {current} 2>nul | findstr testsigning' 2>/dev/null | tail -1)"
        return 0
    fi

    [[ -z "$action" || -z "$feat" ]] && die "Specify --enable or --disable with a feature name"
    local cmd=""
    local reboot=false
    case "${feat,,}" in
        firewall)
            if [[ "$action" == "enable" ]]; then cmd='Set-NetFirewallProfile -All -Enabled True'
            else cmd='Set-NetFirewallProfile -All -Enabled False'; fi;;
        rdp)
            if [[ "$action" == "enable" ]]; then
                cmd='Set-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server" -Name fDenyTSConnections -Value 0'
            else
                cmd='Set-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server" -Name fDenyTSConnections -Value 1'
            fi;;
        kerneldebug|kd)
            if [[ "$action" == "enable" ]]; then
                cmd='bcdedit /debug on; bcdedit /dbgsettings serial debugport:1 baudrate:115200'
            else cmd='bcdedit /debug off'; fi
            reboot=true;;
        singlecpu|numproc1)
            if [[ "$action" == "enable" ]]; then cmd='bcdedit /set numproc 1'
            else cmd='bcdedit /deletevalue numproc'; fi
            reboot=true;;
        testsigning)
            if [[ "$action" == "enable" ]]; then cmd='bcdedit /set testsigning on'
            else cmd='bcdedit /set testsigning off'; fi
            reboot=true;;
        dse|nointegritychecks)
            if [[ "$action" == "enable" ]]; then cmd='bcdedit /set nointegritychecks on'
            else cmd='bcdedit /set nointegritychecks off'; fi
            reboot=true;;
        smbv3compression|smbcompression)
            if [[ "$action" == "enable" ]]; then
                cmd='Set-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name DisableCompression -Value 0 -Type DWord -Force'
            else
                cmd='Set-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name DisableCompression -Value 1 -Type DWord -Force'
            fi;;
        smb2)
            if [[ "$action" == "enable" ]]; then cmd='Set-SmbServerConfiguration -EnableSMB2Protocol $true -Force'
            else cmd='Set-SmbServerConfiguration -EnableSMB2Protocol $false -Force'; fi;;
        aslr)
            if [[ "$action" == "enable" ]]; then
                cmd='Remove-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" -Name MoveImages -EA SilentlyContinue'
            else
                cmd='Set-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" -Name MoveImages -Value 0 -Type DWord -Force'
            fi
            reboot=true;;
        *)
            die "Unknown feature: $feat. Known: Firewall RDP KernelDebug SingleCPU TestSigning DSE SMBv3Compression SMB2 ASLR";;
    esac

    log "${action^} $feat on $name..."
    vm_exec "$ip" "powershell -Command \"$cmd\"" 2>/dev/null
    ok "$feat ${action}d"
    $reboot && warn "Reboot required: xdev-lab stop $name && xdev-lab start $name"
}

