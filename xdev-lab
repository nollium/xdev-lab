#!/bin/bash
#
# xdev-lab — Windows exploit development lab on QEMU/KVM
#
# Targets exact Windows builds. One command from build number to running VM
# with full exploit dev toolchain.
#
# Usage:
#   xdev-lab create --build 26100.32690 --name ws2025-vuln [--ad corp.local]
#   xdev-lab iso    --build 26100.32690
#   xdev-lab vm     --name test --iso /path/to/iso [--ip 10.10.10.30]
#   xdev-lab tools  --vm test [--profile exploit-dev]
#   xdev-lab ad     --vm test --domain corp.local
#   xdev-lab update --vm test --kb KB5082063
#   xdev-lab list
#   xdev-lab start|stop|destroy <name>
#   xdev-lab exec   <name> <command>
#   xdev-lab extract <name> <remote-path> <local-path>
#   xdev-lab snapshot <name> create|restore|list [snap-name]
#   xdev-lab screenshot <name> [output.png]
#
set -euo pipefail

LAB="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
DB="$LAB/vms.json"

BRIDGE="br-lab"
SUBNET="10.10.10"
HOST_IP="${SUBNET}.1"
PASSWORD='Lab@dmin1!'
LM="aad3b435b51404eeaad3b435b51404ee"
NT="c07bbd6d874b375f83efdb1dd809433e"

# ── logging ──────────────────────────────────────────────────────────────

log()  { printf '[*] %s\n' "$*"; }
ok()   { printf '[+] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }
die()  { printf '[-] %s\n' "$*" >&2; exit 1; }

# ── vm database (json, via python oneliners) ─────────────────────────────

_db_get() {
    python3 -c "
import json,os,sys
db=json.load(open('$DB')) if os.path.exists('$DB') else {}
v=db.get('$1',{}).get('$2','')
if v: print(v)
" 2>/dev/null
}

_db_set() {
    python3 -c "
import json,os
p='$DB'
db=json.load(open(p)) if os.path.exists(p) else {}
db.setdefault('$1',{})['$2']='$3'
json.dump(db,open(p,'w'),indent=2)
" 2>/dev/null
}

_db_del() {
    python3 -c "
import json,os
p='$DB'
db=json.load(open(p)) if os.path.exists(p) else {}
db.pop('$1',None)
json.dump(db,open(p,'w'),indent=2)
" 2>/dev/null
}

vm_ip()  { _db_get "$1" ip; }
vm_qmp() { echo "/tmp/qemu-${1}-qmp.sock"; }
vm_pid() { pgrep -f "qemu.*-name $1 " 2>/dev/null | head -1; }
vm_running() { [ -n "$(vm_pid "$1")" ]; }
vm_disk() { echo "$LAB/images/${1}.qcow2"; }

# Require VM to exist in DB and be running. Die with clear message if not.
require_vm() {
    local name="$1"
    local ip=$(vm_ip "$name")
    [[ -z "$ip" ]] && die "VM '$name' not found. Run: xdev-lab list"
    if ! vm_running "$name"; then
        die "VM '$name' is not running. Start it with: xdev-lab start $name"
    fi
    echo "$ip"
}

# ── smb helpers via impacket ─────────────────────────────────────────────

_smb() {
    # $1=ip $2=python-body  (conn object available, authenticated)
    python3 -c "
from impacket.smbconnection import SMBConnection
import sys
conn=SMBConnection('$1','$1')
conn.login('Administrator','','',lmhash='$LM',nthash='$NT')
$2
conn.close()
" 2>/dev/null
}

vm_exec() {
    local ip="$1"; shift
    wmiexec.py -hashes "${LM}:${NT}" "Administrator@${ip}" "$*" 2>&1 \
        | grep -v "^Impacket\|^\[\*\] SMB"
}

vm_upload() {
    local ip="$1" src="$2" dst="$3"
    _smb "$ip" "
with open('$src','rb') as f:
    conn.putFile('C\$','$dst',f.read)
print('ok')
"
}

vm_download() {
    local ip="$1" remote="$2" local_path="$3"
    _smb "$ip" "
with open('$local_path','wb') as f:
    conn.getFile('C\$','$remote',f.write)
print('ok')
"
}

# ── qmp helper ───────────────────────────────────────────────────────────

qmp() {
    local sock="$(vm_qmp "$1")"
    [ -S "$sock" ] || return 1
    python3 -c "
import socket,json,time,sys
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
s.connect('$sock')
s.settimeout(10)
s.recv(4096)
s.sendall(json.dumps({'execute':'qmp_capabilities'}).encode()+b'\n')
time.sleep(0.3);s.recv(4096)
cmd=$2
s.sendall(json.dumps(cmd).encode()+b'\n')
time.sleep(1)
r=s.recv(4096).decode()
s.close()
print(r)
" 2>/dev/null
}

# ── network ──────────────────────────────────────────────────────────────

net_ensure() {
    if ! ip link show "$BRIDGE" &>/dev/null; then
        sudo ip link add "$BRIDGE" type bridge
        sudo ip addr add "${HOST_IP}/24" dev "$BRIDGE"
        sudo ip link set "$BRIDGE" up
        ok "Bridge $BRIDGE created"
    fi
    sudo sysctl -qw net.ipv4.ip_forward=1
    local s="${SUBNET}.0/24"
    sudo iptables -C FORWARD -s "$s" -j ACCEPT 2>/dev/null \
        || sudo iptables -I FORWARD 1 -s "$s" -j ACCEPT
    sudo iptables -C FORWARD -d "$s" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
        || sudo iptables -I FORWARD 1 -d "$s" -m state --state RELATED,ESTABLISHED -j ACCEPT
    sudo iptables -t nat -C POSTROUTING -s "$s" ! -d "$s" -j MASQUERADE 2>/dev/null \
        || sudo iptables -t nat -A POSTROUTING -s "$s" ! -d "$s" -j MASQUERADE
    if ! pgrep -f "dnsmasq.*${BRIDGE}" &>/dev/null; then
        sudo dnsmasq --interface="$BRIDGE" --bind-interfaces --except-interface=lo \
            --dhcp-range="${SUBNET}.100,${SUBNET}.200,12h" \
            --log-facility=/tmp/dnsmasq-lab.log --pid-file=/tmp/dnsmasq-lab.pid 2>/dev/null || true
    fi
}

tap_ensure() {
    local tap="$1"
    # Kill any QEMU still holding this TAP
    if ip link show "$tap" &>/dev/null; then
        local holder=$(ip link show "$tap" 2>/dev/null | grep -oP 'master \K\S+')
        # If the tap exists but is DOWN/no-carrier, delete and recreate
        if ip link show "$tap" 2>/dev/null | grep -q "NO-CARRIER\|state DOWN"; then
            sudo ip link del "$tap" 2>/dev/null || true
        fi
    fi
    if ! ip link show "$tap" &>/dev/null; then
        sudo ip tuntap add dev "$tap" mode tap user "$(whoami)"
    fi
    sudo ip link set "$tap" up 2>/dev/null || true
    sudo brctl addif "$BRIDGE" "$tap" 2>/dev/null || true
}

# Detect the best WIM image index and product key strategy from an ISO
# Sets: _IMG_INDEX, _PRODUCT_KEY_XML
detect_iso_config() {
    local iso="$1" build="${2:-}"
    _IMG_INDEX=1
    _PRODUCT_KEY_XML=""

    local mnt
    mnt=$(mktemp -d) || return 0

    timeout 30 sudo mount -o loop,ro "$iso" "$mnt" 2>/dev/null || { rmdir "$mnt" 2>/dev/null; warn "Could not mount ISO for config detection — using defaults"; return 0; }

    local wim="$mnt/sources/install.wim"
    if [[ ! -f "$wim" ]]; then
        sudo umount "$mnt" 2>/dev/null; rmdir "$mnt" 2>/dev/null; return 0
    fi

    # Parse all image names and pick the best one (pipefail-safe)
    local best_idx
    best_idx=$(wiminfo "$wim" 2>/dev/null | awk '
        /^Index:/ { idx = $2 }
        /^Name:/ {
            name = substr($0, index($0, ":")+2)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            if (name ~ / N$/) next
            if (!found) {
                n = toupper(name)
                if (name ~ /Pro$/ || name == "Windows 10 Pro") { print idx; found=1; exit }
                if (name ~ /Professional$/) { print idx; found=1; exit }
                if (n ~ /SERVERSTANDARD$/ && n !~ /CORE/) { print idx; found=1; exit }
                if (n ~ /STANDARD.*DESKTOP/) { print idx; found=1; exit }
                if (n ~ /STANDARD.*EVALUATION/ && n !~ /CORE/) { best=idx }
                if (n ~ /STANDARD/ && n !~ /CORE/) { if (!best) best=idx }
            }
        }
        END { if (!found) print (best ? best : 1) }
    ') || true
    best_idx="${best_idx%%$'\n'*}"  # strip newlines
    best_idx="${best_idx//[^0-9]/}"  # keep only digits
    _IMG_INDEX="${best_idx:-1}"

    # Get the image name for logging and eval detection
    local img_name
    img_name=$(wiminfo "$wim" 2>/dev/null | awk -v idx="$_IMG_INDEX" '
        /^Index:/ { cur = $2 }
        /^Name:/ { if (cur == idx) { sub(/^.*Name:[[:space:]]*/, ""); gsub(/\r/,""); print; exit } }
    ' || echo "unknown")
    img_name="${img_name%%$'\n'*}"  # strip any trailing newline
    img_name="${img_name%%$'\r'*}"  # strip any trailing CR

    # Product key strategy:
    # - Multi-edition ISOs ALWAYS need a key for unattended edition selection
    # - Eval ISOs: the KMS key works for selection, activation uses embedded eval key
    # - UUP ISOs: KMS key for both selection and activation
    # - Single-edition ISOs: no key needed
    local edition_count
    edition_count=$(wiminfo "$wim" 2>/dev/null | grep -c "^Index:" || echo 1)

    local kms
    kms=$(build_kms_key "${build:-0}") || true
    if [[ "$edition_count" -gt 1 ]] || [[ -n "$kms" ]]; then
        # Multi-edition or KMS-capable: always provide the key
        [[ -n "$kms" ]] && _PRODUCT_KEY_XML="<Key>$kms</Key>"
    fi

    sudo umount "$mnt" 2>/dev/null || true
    rmdir "$mnt" 2>/dev/null || true

    log "  ISO config: index=$_IMG_INDEX ($img_name) key=$([ -n "$_PRODUCT_KEY_XML" ] && echo 'KMS' || echo 'eval/embedded')"
}

next_ip() {
    python3 -c "
import json,os
db=json.load(open('$DB')) if os.path.exists('$DB') else {}
used={int(v.get('ip','0.0.0.0').split('.')[-1]) for v in db.values() if v.get('ip')}
for i in range(10,250):
